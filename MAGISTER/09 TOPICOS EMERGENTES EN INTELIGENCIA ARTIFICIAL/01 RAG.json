{
  "name": "RAG UAI – Workflow Limpio",
  "nodes": [
    {
      "id": "Webhook_Ingest",
      "name": "Upload PDF",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 200],
      "parameters": {
        "path": "upload_pdf",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {
          "binaryData": true
        }
      }
    },
    {
      "id": "Extract_PDF",
      "name": "Extract From File",
      "type": "n8n-nodes-base.fileExtract",
      "typeVersion": 1,
      "position": [400, 200],
      "parameters": {
        "operation": "extractFromPdf",
        "binaryField": "file"
      }
    },
    {
      "id": "Chunk_Code",
      "name": "Chunk Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 200],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javascript",
        "jsCode": "const text = $json.text || \"\";\nif (!text) return [];\n\nconst chunkSize = 1200;\nconst overlap = 200;\nlet i = 0;\nconst chunks = [];\n\nwhile (i < text.length) {\n  const chunk = text.slice(i, i + chunkSize);\n  chunks.push({ document: chunk });\n  i += chunkSize - overlap;\n}\nreturn chunks;"
      }
    },
    {
      "id": "OpenAI_Embed",
      "name": "Embeddings",
      "type": "n8n-nodes-base.openAiEmbeddings",
      "typeVersion": 1,
      "position": [800, 200],
      "parameters": {
        "model": "text-embedding-3-small",
        "textProperty": "document"
      },
      "credentials": {
        "openAiApi": {
          "id": "__REPLACE_OPENAI_KEY__",
          "name": "OpenAI Key"
        }
      }
    },
    {
      "id": "Memory_Vectors",
      "name": "Vector Store (Memory)",
      "type": "n8n-nodes-base.vectorStoreMemory",
      "typeVersion": 1,
      "position": [1000, 200],
      "parameters": {
        "operation": "upsert",
        "vectorField": "embedding",
        "documentField": "document",
        "memoryKey": "novaTech_rag"
      }
    },
    {
      "id": "Webhook_Query",
      "name": "Ask RAG",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 500],
      "parameters": {
        "path": "ask",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      }
    },
    {
      "id": "Vector_Query",
      "name": "Query Vector Store",
      "type": "n8n-nodes-base.vectorStoreMemory",
      "typeVersion": 1,
      "position": [400, 500],
      "parameters": {
        "operation": "query",
        "queryField": "question",
        "memoryKey": "novaTech_rag",
        "limit": 3
      }
    },
    {
      "id": "OpenAI_Answer",
      "name": "OpenAI Answer",
      "type": "n8n-nodes-base.openAiChat",
      "typeVersion": 1,
      "position": [600, 500],
      "parameters": {
        "model": "gpt-4o-mini",
        "systemMessage": "Eres un asistente experto que responde SOLO en base a los documentos proporcionados. Si no hay información suficiente, responde 'No tengo la información en los documentos'.",
        "userMessage": "Pregunta: {{$json.question}}\nContexto:\n{{JSON.stringify($json.matches, null, 2)}}"
      },
      "credentials": {
        "openAiApi": {
          "id": "__REPLACE_OPENAI_KEY__",
          "name": "OpenAI Key"
        }
      }
    }
  ],
  "connections": {
    "Upload PDF": {
      "main": [
        [
          {
            "node": "Extract From File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract From File": {
      "main": [
        [
          {
            "node": "Chunk Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chunk Text": {
      "main": [
        [
          {
            "node": "Embeddings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings": {
      "main": [
        [
          {
            "node": "Vector Store (Memory)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask RAG": {
      "main": [
        [
          {
            "node": "Query Vector Store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Vector Store": {
      "main": [
        [
          {
            "node": "OpenAI Answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
